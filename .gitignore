# Repository-level generated/dependency files
node_modules/
**/node_modules/
**/dist/
**/build/
**/coverage/
**/.cache/

# Secrets and runtime state
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
# Runtime secrets live at the repo-root /secrets/ directory (and at each
# package's own root, handled by that package's .gitignore). Source directories
# such as big-pickle-wallet/src/secrets/ are code and stay trackable.
/secrets/
**/state/
**/data/
**/logs/
**/*.log
**/*.ndjson
**/*.secret
**/*.vault
**/*.vault.*
**/*.key
**/*.pem

# Unrelated workspace projects/artifacts
/astro-dodge/
/astro-dodge-previous-session-scratch/
/package.json

# OS/editor files
.DS_Store
