{
  "name": "big-pickle-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Policy-gated programmable Coinbase (CDP) wallet controller for Big Pickle. TEE custody, enclave-enforced policies, human kill switch, agent gateway.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "tsx src/cli.ts bootstrap",
    "cli": "tsx src/cli.ts",
    "vault": "tsx src/cli.ts vault",
    "wallet": "tsx src/cli.ts wallet",
    "policy": "tsx src/cli.ts policy",
    "control": "tsx src/cli.ts control",
    "approve": "tsx src/cli.ts approve",
    "audit": "tsx src/cli.ts audit",
    "gateway": "tsx src/cli.ts gateway",
    "smoke": "tsx scripts/smoke-test.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.57.0",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
